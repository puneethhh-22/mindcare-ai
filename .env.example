# ============================================================
# MindCare AI – Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- App ---
APP_ENV=development
APP_NAME=MindCare AI
APP_VERSION=1.0.0
DEBUG=true

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=MindCare AI

# --- Database (MongoDB) ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=mindcare_db

# --- Redis (Cache & Sessions) ---
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# --- JWT Authentication ---
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI / LLM ---
# Choose one: openai or gemini
AI_PROVIDER=openai

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=AIzaSyBVR4EOtRnFIS2RnY7n0Puh9eWujz9y7f8
GEMINI_MODEL=gemini-1.5-flash

# HuggingFace (for local sentiment model)
HUGGINGFACE_API_KEY=hf_your_huggingface_key

# --- Email (for reminders) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@mindcare.ai

# --- Firebase (optional, for push notifications) ---
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# --- Encryption ---
ENCRYPTION_KEY=your-32-byte-encryption-key-here!!

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20
